# Copy to .env (never committed) and fill in. On Vercel, set these in
# Project Settings > Environment Variables instead.
GEMINI_API_KEY=
# Optional
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_PRICE_IN_PER_M=0.30
# GEMINI_PRICE_OUT_PER_M=2.50
# To use 3.8 Flash instead:
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_PRICE_IN_PER_M=0.75
# GEMINI_PRICE_OUT_PER_M=3.75
# GEMINI_THINKING_LEVEL=low
# DAILY_REQUEST_CAP=300
